table 'LLE PRODUCTION SCHEDULE'
	lineageTag: 8d35ec29-b91c-4a70-8500-684b20d499d0

	measure 'Units Scheduled' = SUM ( 'LLE PRODUCTION SCHEDULE'[Allocated Units] )
		lineageTag: ee2074e4-76a9-4d5d-a55e-b83528ea6a19

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cost Scheduled' = SUM ( 'LLE PRODUCTION SCHEDULE'[Allocated Cost] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 464fc662-365b-41ef-9f5e-e351d404b575

	measure 'Cost per cMW per Building' =
			
			VAR Denom =
			    SUMX (
			        SUMMARIZE (
			            'LLE PRODUCTION SCHEDULE',
			            'LLE PRODUCTION SCHEDULE'[CAMPUS BLDG SPEC KEY],
			            'LLE PRODUCTION SCHEDULE'[HALL TYPE]
			        ),
			        IF (
			            CONTAINSSTRING ( 'LLE PRODUCTION SCHEDULE'[HALL TYPE], "CORE NETWORK" ),
			            CALCULATE ( MAX ( 'LLE PRODUCTION SCHEDULE'[CORE cMW] ) ),
			            CALCULATE ( MAX ( 'LLE PRODUCTION SCHEDULE'[TOTAL BUILDING cMW] ) )
			        )
			    )
			RETURN
			    DIVIDE ( [Cost Scheduled], Denom )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 6d07d6bc-14ff-40d0-a283-a61010e654c8

	measure 'UNITS (R)' =
			
			IF (
			    NOT HASONEVALUE ( 'LLE PRODUCTION SCHEDULE'[Month] ),
			    SUM ( 'LLE PRODUCTION SCHEDULE'[Allocated Units] ),
			    SUMX (
			        VALUES ( 'LLE PRODUCTION SCHEDULE'[OFCI SHORT] ),
			        VAR ThisOFCI = 'LLE PRODUCTION SCHEDULE'[OFCI SHORT]
			        VAR Cap =
			            CALCULATE (
			                MAX ( 'LLE PRODUCTION SCHEDULE'[PRODUCTION QTY PER MONTH] ),
			                ALLSELECTED ( 'LLE PRODUCTION SCHEDULE' ),
			                'LLE PRODUCTION SCHEDULE'[OFCI SHORT] = ThisOFCI,
			                REMOVEFILTERS ( 'LLE PRODUCTION SCHEDULE'[Month] )
			            )
			        VAR SelDemandOFCI =
			            CALCULATE (
			                SUM ( 'LLE PRODUCTION SCHEDULE'[Allocated Units] ),
			                ALLSELECTED ( 'LLE PRODUCTION SCHEDULE' ),
			                'LLE PRODUCTION SCHEDULE'[OFCI SHORT] = ThisOFCI,
			                REMOVEFILTERS ( 'LLE PRODUCTION SCHEDULE'[Month] )
			            )
			        VAR StartMonth =
			            CALCULATE (
			                MIN ( 'LLE PRODUCTION SCHEDULE'[Month] ),
			                ALLSELECTED ( 'LLE PRODUCTION SCHEDULE' ),
			                'LLE PRODUCTION SCHEDULE'[OFCI SHORT] = ThisOFCI
			            )
			        VAR CurrMonth = MAX ( 'LLE PRODUCTION SCHEDULE'[Month] )
			        VAR k = DATEDIFF ( StartMonth, CurrMonth, MONTH )
			        VAR T = ROUNDUP ( DIVIDE ( SelDemandOFCI, Cap ), 0 )
			        RETURN
			            SUMX (
			                CALCULATETABLE (
			                    SUMMARIZE (
			                        'LLE PRODUCTION SCHEDULE',
			                        'LLE PRODUCTION SCHEDULE'[CAMPUS BLDG SPEC KEY],
			                        'LLE PRODUCTION SCHEDULE'[HALL TYPE],
			                        'LLE PRODUCTION SCHEDULE'[EQUIPMENT]
			                    ),
			                    'LLE PRODUCTION SCHEDULE'[OFCI SHORT] = ThisOFCI
			                ),
			                VAR RowDemand =
			                    CALCULATE (
			                        SUM ( 'LLE PRODUCTION SCHEDULE'[Allocated Units] ),
			                        REMOVEFILTERS ( 'LLE PRODUCTION SCHEDULE'[Month] )
			                    )
			                VAR PerUnit = Cap * DIVIDE ( RowDemand, SelDemandOFCI )
			                VAR Remaining = RowDemand - k * PerUnit
			                RETURN IF ( k >= 0 && k <= T - 1 && Remaining > 0, MIN ( PerUnit, Remaining ) )
			            )
			    )
			)
		formatString: 0
		lineageTag: 48ff6266-b980-4072-80e0-f13efaa9874c

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'COST (R)' =
			
			IF (
			    NOT HASONEVALUE ( 'LLE PRODUCTION SCHEDULE'[Month] ),
			    SUM ( 'LLE PRODUCTION SCHEDULE'[Allocated Cost] ),
			    SUMX (
			        VALUES ( 'LLE PRODUCTION SCHEDULE'[OFCI SHORT] ),
			        VAR ThisOFCI = 'LLE PRODUCTION SCHEDULE'[OFCI SHORT]
			        VAR Cap =
			            CALCULATE (
			                MAX ( 'LLE PRODUCTION SCHEDULE'[PRODUCTION QTY PER MONTH] ),
			                ALLSELECTED ( 'LLE PRODUCTION SCHEDULE' ),
			                'LLE PRODUCTION SCHEDULE'[OFCI SHORT] = ThisOFCI,
			                REMOVEFILTERS ( 'LLE PRODUCTION SCHEDULE'[Month] )
			            )
			        VAR SelDemandOFCI =
			            CALCULATE (
			                SUM ( 'LLE PRODUCTION SCHEDULE'[Allocated Units] ),
			                ALLSELECTED ( 'LLE PRODUCTION SCHEDULE' ),
			                'LLE PRODUCTION SCHEDULE'[OFCI SHORT] = ThisOFCI,
			                REMOVEFILTERS ( 'LLE PRODUCTION SCHEDULE'[Month] )
			            )
			        VAR StartMonth =
			            CALCULATE (
			                MIN ( 'LLE PRODUCTION SCHEDULE'[Month] ),
			                ALLSELECTED ( 'LLE PRODUCTION SCHEDULE' ),
			                'LLE PRODUCTION SCHEDULE'[OFCI SHORT] = ThisOFCI
			            )
			        VAR CurrMonth = MAX ( 'LLE PRODUCTION SCHEDULE'[Month] )
			        VAR k = DATEDIFF ( StartMonth, CurrMonth, MONTH )
			        VAR T = ROUNDUP ( DIVIDE ( SelDemandOFCI, Cap ), 0 )
			        RETURN
			            SUMX (
			                CALCULATETABLE (
			                    SUMMARIZE (
			                        'LLE PRODUCTION SCHEDULE',
			                        'LLE PRODUCTION SCHEDULE'[CAMPUS BLDG SPEC KEY],
			                        'LLE PRODUCTION SCHEDULE'[HALL TYPE],
			                        'LLE PRODUCTION SCHEDULE'[EQUIPMENT]
			                    ),
			                    'LLE PRODUCTION SCHEDULE'[OFCI SHORT] = ThisOFCI
			                ),
			                VAR RowDemand =
			                    CALCULATE (
			                        SUM ( 'LLE PRODUCTION SCHEDULE'[Allocated Units] ),
			                        REMOVEFILTERS ( 'LLE PRODUCTION SCHEDULE'[Month] )
			                    )
			                VAR UnitCost =
			                    CALCULATE (
			                        MAX ( 'LLE PRODUCTION SCHEDULE'[COST PER UM (MIXED)] ),
			                        REMOVEFILTERS ( 'LLE PRODUCTION SCHEDULE'[Month] )
			                    )
			                VAR PerUnit = Cap * DIVIDE ( RowDemand, SelDemandOFCI )
			                VAR Remaining = RowDemand - k * PerUnit
			                VAR RowUnits = IF ( k >= 0 && k <= T - 1 && Remaining > 0, MIN ( PerUnit, Remaining ) )
			                RETURN RowUnits * UnitCost
			            )
			    )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 4c18bfbf-180f-4a84-86f3-8d94ad876500

	measure 'Deposit (R)' =
			
			IF (
			    NOT HASONEVALUE ( 'LLE PRODUCTION SCHEDULE'[Month] ),
			    0.20 * [COST (R)],
			    VAR M = MAX ( 'LLE PRODUCTION SCHEDULE'[Month] )
			    RETURN
			        SUMX (
			            VALUES ( 'LLE PRODUCTION SCHEDULE'[OFCI SHORT] ),
			            VAR dm = CALCULATE ( MAX ( 'LLE PRODUCTION SCHEDULE'[Deposit Month] ) )
			            VAR cost = CALCULATE ( [COST (R)], REMOVEFILTERS ( 'LLE PRODUCTION SCHEDULE'[Month] ) )
			            RETURN IF ( dm = M, 0.20 * cost, 0 )
			        )
			)
		lineageTag: 1cd73e22-e80b-4868-9418-a95d2379cd7a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Delivery (R)' =
			
			IF (
			    NOT HASONEVALUE ( 'LLE PRODUCTION SCHEDULE'[Month] ),
			    0.75 * [COST (R)],
			    0.75 * [COST (R)]
			)
		lineageTag: b52f3a15-cef1-492d-844c-5dd40e528566

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Retention (R)' =
			
			IF (
			    NOT HASONEVALUE ( 'LLE PRODUCTION SCHEDULE'[Month] ),
			    0.05 * [COST (R)],
			    VAR M = MAX ( 'LLE PRODUCTION SCHEDULE'[Month] )
			    VAR DeliveryMonth = EDATE ( M, -6 )
			    VAR RealDeliveryExists =
			        CALCULATE (
			            COUNTROWS ( 'LLE PRODUCTION SCHEDULE' ),
			            REMOVEFILTERS ( 'LLE PRODUCTION SCHEDULE'[Month] ),
			            'LLE PRODUCTION SCHEDULE'[Month] = DeliveryMonth
			        )
			    VAR DeliveryThatMonth =
			        CALCULATE (
			            [COST (R)],
			            REMOVEFILTERS ( 'LLE PRODUCTION SCHEDULE'[Month] ),
			            'LLE PRODUCTION SCHEDULE'[Month] = DeliveryMonth
			        )
			    RETURN
			        IF ( RealDeliveryExists > 0, 0.05 * DeliveryThatMonth )
			)
		lineageTag: eb7d4d57-9b95-46a8-9316-09fa5c95f551

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Payment (R)' =
			
			VAR M = MAX ( 'LLE PRODUCTION SCHEDULE'[Month] )
			RETURN
			IF (
			    NOT HASONEVALUE ( 'LLE PRODUCTION SCHEDULE'[Month] ),
			    [COST (R)],
			    VAR Delivery = 0.75 * [COST (R)]
			    VAR DeliveryMonth = EDATE ( M, -6 )
			    VAR RealDeliveryExists =
			        CALCULATE (
			            COUNTROWS ( 'LLE PRODUCTION SCHEDULE' ),
			            REMOVEFILTERS ( 'LLE PRODUCTION SCHEDULE'[Month] ),
			            'LLE PRODUCTION SCHEDULE'[Month] = DeliveryMonth
			        )
			    VAR Retention =
			        IF (
			            RealDeliveryExists > 0,
			            0.05 * CALCULATE (
			                [COST (R)],
			                REMOVEFILTERS ( 'LLE PRODUCTION SCHEDULE'[Month] ),
			                'LLE PRODUCTION SCHEDULE'[Month] = DeliveryMonth
			            ),
			            0
			        )
			    VAR Deposit =
			        SUMX (
			            VALUES ( 'LLE PRODUCTION SCHEDULE'[OFCI SHORT] ),
			            VAR dm = CALCULATE ( MAX ( 'LLE PRODUCTION SCHEDULE'[Deposit Month] ) )
			            VAR cost = CALCULATE ( [COST (R)], REMOVEFILTERS ( 'LLE PRODUCTION SCHEDULE'[Month] ) )
			            RETURN IF ( dm = M, 0.20 * cost, 0 )
			        )
			    RETURN Delivery + Retention + Deposit
			)
		lineageTag: 7842daa0-2d32-4a1f-a5c5-3f589b12b94f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

