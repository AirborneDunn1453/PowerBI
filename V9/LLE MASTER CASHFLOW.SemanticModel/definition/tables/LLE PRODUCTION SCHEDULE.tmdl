	column 'Deposit Month'
		dataType: dateTime
		formatString: Mmm-yyyy
		lineageTag: 292d954a-ddbb-42a5-b7b8-a3eef321f7a3
		summarizeBy: none
		sourceColumn: Deposit Month

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isCustom":true}

	partition 'LLE PRODUCTION SCHEDULE' = m
		mode: import
		source =
				let
				    Src = #"LLE CASHFLOW MASTER",
				    Source = Table.Buffer(
				        Table.TransformColumns(Src, {{"PRODUCTION QTY PER MONTH", each Number.From(_), type number}})
				    ),
				    Attr = Table.Buffer(
				        Table.Group(
				            Source, {"CAMPUS BLDG SPEC KEY"},
				            {
				                {"SPEC",        each List.First([SPEC]), type text},
				                {"CAMPUS CODE", each List.First([CAMPUS CODE]), type text},
				                {"BUILDING ID", each List.First([BUILDING ID]), type text},
				                {"TOTAL BUILDING cMW", each List.Max([TOTAL BUILDING cMW]), type number},
				                {"CORE cMW", each List.Max([CORE cMW]), type number}
				            }
				        )
				    ),
				    AttrPlus0 = Table.AddColumn(Attr, "CAMPUS + BUILDING",
				        each Text.Combine({[CAMPUS CODE], [BUILDING ID]}, " "), type text),
				    AttrPlus = Table.AddColumn(AttrPlus0, "CAMPUS + BUILDING + SPEC",
				        each Text.Combine({[CAMPUS CODE], [BUILDING ID], [SPEC]}, " "), type text),
				
				    CapByOFCI = Table.Group(
				        Source, {"OFCI SHORT"},
				        {{"Capacity", each List.Max([PRODUCTION QTY PER MONTH]), type number}}
				    ),
				    CapLookup = Record.FromList(CapByOFCI[Capacity], CapByOFCI[OFCI SHORT]),
				
				    // ---- deposit month per OFCI package = month AFTER earliest PO date ----
				    DepGrp = Table.AddColumn(
				        Table.Group(Source, {"OFCI SHORT"}, {{"PODate", each List.Min([PO DATE]), type date}}),
				        "Deposit Month", each Date.AddMonths(Date.StartOfMonth([PODate]), 1), type date),
				    DepLookup = Record.FromList(DepGrp[#"Deposit Month"], DepGrp[OFCI SHORT]),
				
				    Ext = Table.AddColumn(Source, "Ext",
				        each [QTY PER BUILDING] * [#"COST PER UM (MIXED)"], type number),
				    Bldg = Table.Group(
				        Ext, {"OFCI SHORT", "CAMPUS BLDG SPEC KEY", "HALL TYPE", "DISCIPLINE", "FIT UP / FIT OUT", "EQUIPMENT"},
				        {
				            {"Demand",       each List.Sum([QTY PER BUILDING]), type number},
				            {"WeightedCost", each List.Sum([Ext]), type number},
				            {"StartMonth",   each Date.StartOfMonth(List.Min([Delivery Start Date])), type date},
				            {"LEAD TIME WKS", each List.Max([LEAD TIME WKS]), type number},
				            {"SIZE/CONFIGURATION", each List.First([#"SIZE/CONFIGURATION"]), type text},
				            {"COMMENTS", each List.First([COMMENTS]), type text},
				            {"UM", each List.First([UM]), type text},
				            {"COST CODE", each List.First([#"COST CODE"]), type text},
				            {"COST CODE NAME", each List.First([#"COST CODE NAME"]), type text}
				        }
				    ),
				    BldgCPU = Table.AddColumn(Bldg, "CostPerUnit",
				        each if [Demand] = 0 then 0 else [WeightedCost] / [Demand], type number),
				    BldgKeyed = Table.AddColumn(BldgCPU, "UnitKey",
				        each [OFCI SHORT] & " || " & [CAMPUS BLDG SPEC KEY] & " || " & [HALL TYPE]
				             & " || " & ([DISCIPLINE] ?? "") & " || " & ([#"FIT UP / FIT OUT"] ?? "")
				             & " || " & ([EQUIPMENT] ?? ""), type text),
				    Descr = Table.Buffer(Table.SelectColumns(BldgKeyed, {"UnitKey", "SIZE/CONFIGURATION", "COMMENTS", "UM", "COST CODE", "COST CODE NAME"})),
				    Groups = Table.Group(BldgKeyed, {"OFCI SHORT"}, {{"g", each _, type table}}),
				
				    ApportionWhole = (items as list, total as number) as list =>
				        let
				            tot = List.Sum(List.Transform(items, each _[W])),
				            cap = Number.RoundDown(total),
				            raw = List.Transform(items, each
				                    let exact = if tot <= 0 then 0 else cap * _[W] / tot
				                    in _ & [Floor = Number.RoundDown(exact), Frac = exact - Number.RoundDown(exact)]),
				            baseSum = List.Sum(List.Transform(raw, each [Floor])),
				            leftover = cap - baseSum,
				            ranked = List.Sort(raw, {each [Frac], Order.Descending}),
				            withBonus = List.Transform(
				                List.Positions(ranked),
				                (p) => let r = ranked{p} in r & [Units = r[Floor] + (if p < leftover then 1 else 0)]),
				            capped = List.Transform(withBonus, each _ & [Final = List.Min({[Units], [W]})])
				        in
				            capped,
				
				    AllocateOFCI = (units as table, capacity as number) as list =>
				        let
				            firstMonth  = Date.StartOfMonth(List.Min(units[StartMonth])),
				            latestStart = Date.StartOfMonth(List.Max(units[StartMonth])),
				            spread      = (Date.Year(latestStart) - Date.Year(firstMonth)) * 12
				                          + (Date.Month(latestStart) - Date.Month(firstMonth)),
				            totalDemand = List.Sum(units[Demand]),
				            prodMonths  = if capacity <= 0 then 0 else Number.RoundUp(totalDemand / capacity),
				            monthsNeeded = spread + prodMonths + 6,
				            initRem = List.Buffer(List.Transform(
				                Table.ToRecords(units),
				                (r) => [ UKey = r[UnitKey],
				                         BKey = r[CAMPUS BLDG SPEC KEY],
				                         Hall = r[HALL TYPE],
				                         Disc = r[DISCIPLINE],
				                         Fit  = r[#"FIT UP / FIT OUT"],
				                         Lead = r[LEAD TIME WKS],
				                         Equip = r[EQUIPMENT],
				                         Start = Date.StartOfMonth(r[StartMonth]),
				                         Remaining = r[Demand],
				                         CPU = r[CostPerUnit] ]
				            )),
				            result = List.Accumulate(
				                {0 .. monthsNeeded},
				                [ Rem = initRem, Out = {} ],
				                (state, i) =>
				                    let
				                        m = Date.AddMonths(firstMonth, i),
				                        rem = state[Rem],
				                        eligible = List.Select(rem,
				                            each _[Start] <= m and _[Remaining] > 0.0000001),
				                        sumRem = List.Sum(List.Transform(eligible, each _[Remaining])),
				                        thisCap = List.Min({capacity, sumRem}),
				                        items = List.Transform(eligible,
				                            each [UKey=_[UKey], BKey=_[BKey], Hall=_[Hall], Disc=_[Disc], Fit=_[Fit], Lead=_[Lead], Equip=_[Equip], W=_[Remaining], CPU=_[CPU]]),
				                        appt = if List.Count(eligible) = 0 or thisCap <= 0
				                               then {}
				                               else ApportionWhole(items, thisCap),
				                        allocThisMonth = List.Transform(
				                            List.Select(appt, each [Final] > 0),
				                            each [ UKey=_[UKey], BKey=_[BKey], Hall=_[Hall], Disc=_[Disc], Fit=_[Fit], Lead=_[Lead], Equip=_[Equip],
				                                   Units=_[Final], CPU=_[CPU], Month=m ]),
				                        usedRec = Record.FromList(
				                            List.Transform(allocThisMonth, each _[Units]),
				                            List.Transform(allocThisMonth, each _[UKey])),
				                        newRem = List.Transform(rem,
				                            (b) => [ UKey=b[UKey], BKey=b[BKey], Hall=b[Hall], Disc=b[Disc], Fit=b[Fit], Lead=b[Lead], Equip=b[Equip], Start=b[Start],
				                                     Remaining = b[Remaining] - Record.FieldOrDefault(usedRec, b[UKey], 0),
				                                     CPU=b[CPU] ])
				                    in
				                        [ Rem = newRem, Out = state[Out] & { allocThisMonth } ]
				            )
				        in
				            List.Combine(result[Out]),
				
				    PerOFCI = List.Transform(
				        Table.ToRecords(Groups),
				        (grp) =>
				            let
				                o    = grp[OFCI SHORT],
				                cap  = Record.FieldOrDefault(CapLookup, o, 0),
				                recs = AllocateOFCI(grp[g], cap)
				            in
				                List.Transform(recs, each _ & [#"OFCI SHORT" = o, #"PRODUCTION QTY PER MONTH" = cap, #"Deposit Month" = Record.FieldOrDefault(DepLookup, o, null)])
				    ),
				    AllRecs = List.Combine(PerOFCI),
				    AsTable = Table.FromRecords(AllRecs),
				
				    WithCost = Table.AddColumn(AsTable, "Allocated Cost", each [Units] * [CPU], type number),
				    Shaped = Table.RenameColumns(
				        Table.SelectColumns(WithCost,
				            {"OFCI SHORT", "BKey", "Hall", "Disc", "Fit", "Lead", "Equip", "CPU", "PRODUCTION QTY PER MONTH", "Deposit Month", "Month", "Units", "Allocated Cost", "UKey"}),
				        {{"BKey", "CAMPUS BLDG SPEC KEY"}, {"Hall", "HALL TYPE"},
				         {"Disc", "DISCIPLINE"}, {"Fit", "FIT UP / FIT OUT"}, {"Lead", "LEAD TIME WKS"},
				         {"Equip", "EQUIPMENT"}, {"CPU", "COST PER UM (MIXED)"}, {"Units", "Allocated Units"}}),
				    Filtered = Table.SelectRows(Shaped, each [Allocated Units] > 0.0000001),
				
				    Joined = Table.NestedJoin(Filtered, {"CAMPUS BLDG SPEC KEY"},
				                              AttrPlus, {"CAMPUS BLDG SPEC KEY"}, "attr", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "attr",
				                              {"CAMPUS CODE", "BUILDING ID", "SPEC", "CAMPUS + BUILDING", "CAMPUS + BUILDING + SPEC", "TOTAL BUILDING cMW", "CORE cMW"},
				                              {"CAMPUS CODE", "BUILDING ID", "SPEC", "CAMPUS + BUILDING", "CAMPUS + BUILDING + SPEC", "TOTAL BUILDING cMW", "CORE cMW"}),
				    WithHallCombo = Table.AddColumn(Expanded, "CAMPUS + BUILDING + HALL TYPE",
				        each Text.Combine({[CAMPUS CODE], [BUILDING ID], [HALL TYPE]}, " "), type text),
				    JoinedDescr = Table.NestedJoin(WithHallCombo, {"UKey"}, Descr, {"UnitKey"}, "descr", JoinKind.LeftOuter),
				    ExpandedDescr = Table.ExpandTableColumn(JoinedDescr, "descr",
				        {"SIZE/CONFIGURATION", "COMMENTS", "UM", "COST CODE", "COST CODE NAME"},
				        {"SIZE/CONFIGURATION", "COMMENTS", "UM", "COST CODE", "COST CODE NAME"}),
				    WithCostCodeCombo = Table.AddColumn(ExpandedDescr, "COST CODE + NAME",
				        each Text.Combine({[#"COST CODE"] ?? "", [#"COST CODE NAME"] ?? ""}, " - "), type text),
				    Cleaned = Table.RemoveColumns(WithCostCodeCombo, {"UKey"}),
				
				    Typed = Table.TransformColumnTypes(Cleaned, {
				        {"OFCI SHORT", type text}, {"CAMPUS BLDG SPEC KEY", type text},
				        {"HALL TYPE", type text}, {"SPEC", type text},
				        {"CAMPUS CODE", type text}, {"BUILDING ID", type text},
				        {"CAMPUS + BUILDING", type text}, {"CAMPUS + BUILDING + SPEC", type text},
				        {"CAMPUS + BUILDING + HALL TYPE", type text},
				        {"TOTAL BUILDING cMW", type number}, {"CORE cMW", type number},
				        {"DISCIPLINE", type text}, {"FIT UP / FIT OUT", type text},
				        {"LEAD TIME WKS", type number}, {"PRODUCTION QTY PER MONTH", type number}, {"Deposit Month", type date},
				        {"EQUIPMENT", type text}, {"COST PER UM (MIXED)", type number},
				        {"SIZE/CONFIGURATION", type text}, {"COMMENTS", type text}, {"UM", type text},
				        {"COST CODE", type text}, {"COST CODE NAME", type text}, {"COST CODE + NAME", type text},
				        {"Month", type date}, {"Allocated Units", Int64.Type},
				        {"Allocated Cost", type number} }),
				    #"Renamed Columns" = Table.RenameColumns(Typed,{{"SPEC", "LEASE OPTION"}})
				in
				    #"Renamed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

